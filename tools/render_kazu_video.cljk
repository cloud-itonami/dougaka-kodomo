       "<circle cx='66' cy='240' r='16' fill='#FFE3C9'/>"
       "<circle cx='214' cy='240' r='16' fill='#FFE3C9'/>"
       "<rect x='102' y='306' width='24' height='34' rx='11' fill='#FFE3C9'/>"
