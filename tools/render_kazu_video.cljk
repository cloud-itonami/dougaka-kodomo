       "<circle cx='140' cy='120' r='76' fill='#FFE3C9'/>"
       "<circle cx='112' cy='120' r='9' fill='#3A2B22'/><circle cx='115' cy='117' r='3' fill='#fff'/>"
       "<circle cx='168' cy='120' r='9' fill='#3A2B22'/><circle cx='171' cy='117' r='3' fill='#fff'/>"
